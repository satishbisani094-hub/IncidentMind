# IncidentMind Environment Configuration

# Server Config
PORT=5000
NODE_ENV=development

# Hindsight Memory Engine Configuration
# Official Hindsight Cloud or Self-hosted endpoint
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hs_demo_key_incidentmind
HINDSIGHT_BANK_ID=incidentmind-production

# AI / LLM Configuration
# Supports Google Gemini, OpenAI, or compatible endpoint
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Database Configuration (Defaults to SQLite for local zero-config, or PostgreSQL)
DATABASE_URL=file:./dev.db
